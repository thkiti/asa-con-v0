  @@index([createdAt(sort: Desc)])
}

enum LegacySalesImportBatchStatus {
  STAGING
  VALIDATED
  CONVERTING
  COMPLETED
  FAILED
}

enum LegacySalesImportRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED
  SKIPPED
}

/// Batch header for legacy SAE.dbf sales staging / convert runs.
model LegacySalesImportBatch {
  id                   String                       @id @default(uuid())
  sourceFileName       String
  year                 Int
  startedAt            DateTime                     @default(now())
  finishedAt           DateTime?
  status               LegacySalesImportBatchStatus @default(STAGING)
  totalRows            Int                          @default(0)
  acceptedRows         Int                          @default(0)
  skippedOldRows       Int                          @default(0)
  invalidRows          Int                          @default(0)
  importedTransactions Int                          @default(0)
  importedLines        Int                          @default(0)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  rows              LegacySalesImportRow[]
  legacySaleRefs    LegacySaleReference[]

  @@index([sourceFileName, year])
  @@index([startedAt(sort: Desc)])
}

/// One SAE.dbf line staged before validation and convert.
model LegacySalesImportRow {
  id                     String                     @id @default(uuid())
  sourceFileName         String
  sourceRowNo            Int
  legacyTransNo          String
  legacyDate             String
  legacyTime             String
  legacyBranchId         String
  legacyStaffId          String?
  legacyProductCode      String
  qty                    Int
  amount                 Decimal                    @db.Decimal(18, 2)
  normalizedSaleDateTime DateTime?
  importBatchId          String
  status                 LegacySalesImportRowStatus @default(PENDING)
  errorCode              String?
  errorMessage           String?                    @db.Text
  mappedBranchId         String?
  mappedStaffId          String?
  mappedProductId        String?
  createdSaleId          String?
  createdReceiptId       String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  importBatch LegacySalesImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([sourceFileName, sourceRowNo])
  @@index([importBatchId, status])
  @@index([importBatchId, legacyTransNo])
  @@index([mappedBranchId, legacyDate, legacyTransNo])
}

/// Auditable link from imported Sale back to legacy S_TRANS (not used as receipt no).
model LegacySaleReference {
  id             String   @id @default(uuid())
  saleId         String   @unique
  importBatchId  String
  sourceFileName String
  legacyTransNo  String
  legacyBranchId String
  legacySaleDate String
  legacySaleTime String?
  createdAt      DateTime @default(now())

  sale        Sale                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  importBatch LegacySalesImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([sourceFileName, legacyBranchId, legacySaleDate, legacyTransNo])
  @@index([importBatchId])
}
