generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// DATABASE_URL: see prisma.config.ts datasource.url (Prisma 7 — url not allowed in schema file)
datasource db {
  provider = "postgresql"
}

enum Role {
  HO_FINANCE
  HO_ADMIN
  HO_OPERATIONS
  SH_STAFF
}

enum BranchType {
  HO
  SH
}

enum ProductType {
  TRACKED
  CONSUMABLE
}

enum DocType {
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  PERFORMANCE
}

enum DocStatus {
  DRAFT
  SUBMITTED
  SHIPPED
  CONFIRMED
  RECEIVED
  POSTED
  TRANSFERRED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
}

enum RefundKind {
  SALE_LINKED
  GOODWILL
}

enum PaymentMethod {
  CASH
  CARD
  QR
  TRANSFER
  OTHER
  BANK_TRANSFER
}

enum PaymentEvidenceStatus {
  PENDING
  UPLOADED
  MISSING
}

enum LedgerSkipReason {
  CONSUMABLE
}

enum MarketType {
  SERVICES
  OUTSIDERS
}

enum PricingClass {
  MATERIAL
  MACHINERY
  CONSUMABLE
}

enum RoundingMode {
  NONE
  CENT_01
  CENT_05
  BAHT_1
  BAHT_10
  BAHT_100
}

model Branch {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  type      BranchType @default(SH)
  address   String?
  phone     String?
  /// HO999 = company tax ID; SH* = POS machine / approval ID (see receipt print rules).
  taxId     String?
  isActive  Boolean    @default(true)
  deleted   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  staffs            Staff[]
  stocks            Stock[]
  stockLayers       StockLayer[]
  stockTransactions StockTransaction[]
  stockDocuments    StockDocument[]
  sales             Sale[]
  refunds           Refund[]
  vouchers                 Voucher[]
  manualJournalEntries     ManualJournalEntry[]
  paymentVouchers          PaymentVoucher[]
  pettyCashVouchers        PettyCashVoucher[]
  revenueVouchers          RevenueVoucher[]
  accountingPeriods        AccountingPeriod[]
  reconciliationSnapshots  ReconciliationSnapshot[]
  salesTargets             BranchSalesTarget[]
  workTimeEntries          WorkTimeEntry[]
}

/// HO monthly sales target per shop branch — daily split uses weekPattern Mon..Sun weights.
model BranchSalesTarget {
  id           String   @id @default(uuid())
  branchId     String
  year         Int
  month        Int
  monthlyTotal Decimal  @db.Decimal(18, 2)
  weekPattern  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year, month])
  @@index([branchId, year, month])
}

/// POS staff daily clock-in/out — one row per branch + staff + Bangkok calendar date.
model WorkTimeEntry {
  id          String    @id @default(uuid())
  branchId    String
  /// Staff login code (Staff.staffId), same as Sale.staffId.
  staffId     String
  /// Bangkok calendar date YYYY-MM-DD.
  workDate    String
  clockInAt   DateTime?
  clockOutAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, staffId, workDate])
  @@index([branchId, staffId, workDate])
}

model Staff {
  id            String   @id @default(cuid())
  staffId       String   @unique
  password      String
  name          String
  role          Role
  branchId              String
  posCanCollect         Boolean  @default(false)
  /// ล็อกอิน POS ที่สาขาร้านอื่นได้ (พนักงานแทน)
  allowAnyBranchLogin   Boolean  @default(false)
  deleted               Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch                         Branch                   @relation(fields: [branchId], references: [id])
  reconciliationSnapshotsCreated ReconciliationSnapshot[]
}

model Product {
  id          String      @id @default(uuid())
  groupCode   Int
  typeCode    Int
  runningCode Int
  code        String      @unique
  name        String
  productType ProductType @default(TRACKED)
  deleted     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  referenceStocks    ReferenceStock[]
  stocks             Stock[]
  stockLayers        StockLayer[]
  stockTransactions  StockTransaction[]
  stockDocumentLines StockDocumentLine[]
  saleItems          SaleItem[]
  sellingPrices      SellingPrice[]

  @@unique([groupCode, typeCode, runningCode])
}

model PricingPolicy {
  id            String       @id @default(uuid())
  marketType    MarketType
  pricingClass  PricingClass
  markupPercent Decimal      @db.Decimal(5, 4)
  roundingMode  RoundingMode
  threshold     Decimal?     @db.Decimal(18, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())

  @@index([marketType, pricingClass, effectiveTo])
  @@index([marketType, pricingClass, effectiveFrom])
}

model SellingPrice {
  id            String    @id @default(uuid())
  productId     String
  price         Decimal   @db.Decimal(18, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveTo])
  @@index([productId, effectiveFrom])
}

model ReferenceStock {
  id           String   @id @default(uuid())
  hookGroup    String
  hookNo       Int
  supplierCode String
  productCode  String
  productGroup String?
  productId    String
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, hookGroup, hookNo])
}

model Stock {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  qty       Int      @default(0)
  avgCost   Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model StockLayer {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  qty       Int
  qtyRemain Int
  unitCost  Decimal  @db.Decimal(18, 6)
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model StockTransaction {
  id          String   @id @default(uuid())
  branchId    String
  productId   String
  date        DateTime
  qtyIn       Int      @default(0)
  qtyOut      Int      @default(0)
  unitCost    Decimal  @db.Decimal(18, 6)
  beforeQty   Int
  afterQty    Int
  beforeValue Decimal  @db.Decimal(18, 6)
  afterValue  Decimal  @db.Decimal(18, 6)
  refType     String
  refId       String
  refLineId   String
  documentId  String?
  createdAt   DateTime @default(now())

  branch   Branch         @relation(fields: [branchId], references: [id])
  product  Product        @relation(fields: [productId], references: [id])
  document StockDocument? @relation(fields: [documentId], references: [id])
}

model StockDocument {
  id                 String    @id @default(uuid())
  refNo              String    @unique
  docType            DocType
  status             DocStatus @default(DRAFT)
  date               DateTime
  branchId           String
  legalEntityCode    String
  periodMonth        String?
  fromLocId          String?
  toLocId            String?
  submittedAt        DateTime?
  confirmedAt        DateTime?
  postedAt           DateTime?
  createdByStaffId   String?
  confirmedByStaffId String?
  postedByStaffId    String?
  cancelledAt        DateTime?
  cancelledByStaffId String?
  cancelReason       String?   @db.Text
  createdAt          DateTime  @default(now())

  branch       Branch              @relation(fields: [branchId], references: [id])
  legalEntity  LegalEntity         @relation(fields: [legalEntityCode], references: [code])
  lines        StockDocumentLine[]
  transactions StockTransaction[]

  @@index([legalEntityCode, date])
  @@index([legalEntityCode, docType, status])
}

model StockDocumentLine {
  id                 String @id @default(uuid())
  documentId         String
  productId          String
  qty                Int
  endingQty          Int?
  reviewPostingDelta Int?

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model DocumentCounter {
  id      String @id @default(uuid())
  docType String
  shopId  String
  period  String
  running Int    @default(0)

  @@unique([docType, shopId, period])
}

model Sale {
  id        String     @id @default(uuid())
  branchId  String
  staffId   String?
  total     Decimal    @db.Decimal(18, 2)
  status    SaleStatus @default(COMPLETED)
  createdAt DateTime   @default(now())

  branch               Branch                @relation(fields: [branchId], references: [id])
  items                SaleItem[]
  payment              Payment?
  receipt              Receipt?
  refunds              Refund[]
  paymentEvidence      PaymentEvidence?
  legacySaleReference  LegacySaleReference?
}

model SaleItem {
  id                  String             @id @default(uuid())
  saleId              String
  productId           String
  productType         ProductType
  qty                 Int
  unitPrice           Decimal            @db.Decimal(18, 2)
  lineTotal           Decimal            @db.Decimal(18, 2)
  ledgerSkippedReason LedgerSkipReason?
  createdAt           DateTime           @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String        @unique
  method    PaymentMethod
  amount    Decimal       @db.Decimal(18, 2)
  change    Decimal       @default(0) @db.Decimal(18, 2)
  createdAt DateTime      @default(now())

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentEvidence PaymentEvidence?
}

model Receipt {
  id        String   @id @default(uuid())
  saleId    String   @unique
  branchId  String
  receiptNo String
  issuedAt  DateTime @default(now())

  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refundsAsOriginal Refund[]          @relation("OriginalReceipt")
  paymentEvidence   PaymentEvidence?

  @@unique([branchId, receiptNo])
}

/// Bank-transfer slip evidence — keyed by receiptNo.
model PaymentEvidence {
  id           String                @id @default(uuid())
  branchId     String
  receiptNo    String
  receiptId    String                @unique
  saleId       String                @unique
  paymentId    String                @unique
  status       PaymentEvidenceStatus @default(PENDING)
  blobPathname String?
  blobUrl      String?
  mimeType     String                @default("image/jpeg")
  byteSize     Int?
  uploadedAt   DateTime?
  uploadError  String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([branchId, receiptNo])
  @@index([branchId, status])
}

model Refund {
  id                 String     @id @default(uuid())
  refundNo           String     @unique
  kind               RefundKind
  saleId             String?
  branchId           String
  staffId            String?
  originalReceiptId  String?
  amount             Decimal    @db.Decimal(18, 2)
  reasonCode         String?
  reason             String?    @db.Text
  createdAt          DateTime   @default(now())

  sale            Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  branch          Branch   @relation(fields: [branchId], references: [id])
  originalReceipt Receipt? @relation("OriginalReceipt", fields: [originalReceiptId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([branchId, createdAt])
  @@index([kind])
}

/// Singleton receipt layout/footer (id = "default").
/// P2B drop deferred — keep until ThermalDocumentLayout backfill is verified in DB.
model ReceiptPrintSettings {
  id                      String   @id @default("default")
  companyDisplayName      String?
  footerLine1             String?
  footerLine2             String?
  footerLine3             String?
  footerLine4             String?
  footerLine5             String?
  showAbbreviatedTaxTitle Boolean  @default(true)
  showVatIncludedMessage  Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

enum ThermalDocumentType {
  RECEIPT
  REFUND
  COLLECTOR
  REPAIR_TICKET
  READ_Z
}

/// Thermal 80mm layout — one row per document type.
model ThermalDocumentLayout {
  documentType            ThermalDocumentType @id
  headerLine1             String?
  headerLine2             String?
  headerLine3             String?
  footerLine1             String?
  footerLine2             String?
  footerLine3             String?
  footerLine4             String?
  footerLine5             String?
  showAbbreviatedTaxTitle Boolean             @default(true)
  showVatIncludedMessage  Boolean             @default(true)
  updatedAt               DateTime            @updatedAt
}

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherStatus {
  DRAFT
  POSTED
  VOIDED
}

enum AccountingPeriodStatus {
  /// Posting allowed
  OPEN
  /// Posting blocked; soft close (reopen workflow deferred)
  SOFT_CLOSED
  /// Posting blocked; hard close / locked
  HARD_CLOSED
}

enum AccountingPeriodReopenRequestStatus {
  PENDING
  REJECTED
  CANCELLED
  EXECUTED
}

enum ManualJournalEntryType {
  MANUAL
  OPENING_BALANCE
  ADJUSTMENT
  RECLASS
  ACCRUAL
  AUDITOR_ADJUSTMENT
}

enum ManualJournalEntryStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  POSTED
  CANCELLED
}

enum PaymentVoucherStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  POSTED
  CANCELLED
}

enum PettyCashVoucherStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  POSTED
  CANCELLED
}

enum RevenueVoucherStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  POSTED
  CANCELLED
}

model GlAccount {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  accountType GlAccountType
  isActive    Boolean        @default(true)
  deleted     Boolean        @default(false)
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent            GlAccount?         @relation("GlAccountHierarchy", fields: [parentId], references: [id])
  children          GlAccount[]        @relation("GlAccountHierarchy")
  voucherLines              VoucherLine[]
  journalEntryLines         JournalEntryLine[]
  manualJournalEntryLines   ManualJournalEntryLine[]
  paymentVoucherPayFrom     PaymentVoucher[]     @relation("PaymentVoucherPayFrom")
  paymentVoucherLines       PaymentVoucherLine[]
  pettyCashVoucherPettyCash PettyCashVoucher[]   @relation("PettyCashVoucherPettyCash")
  pettyCashVoucherLines     PettyCashVoucherLine[]
  revenueVoucherReceiveTo   RevenueVoucher[]     @relation("RevenueVoucherReceiveTo")
  revenueVoucherLines       RevenueVoucherLine[]
}

model LegalEntity {
  code    String  @id
  name    String
  address String?
  taxId   String?

  vouchers             Voucher[]
  journalEntries       JournalEntry[]
  manualJournalEntries ManualJournalEntry[]
  paymentVouchers      PaymentVoucher[]
  pettyCashVouchers    PettyCashVoucher[]
  revenueVouchers      RevenueVoucher[]
  accountingPeriods    AccountingPeriod[]
  stockDocuments       StockDocument[]
}

model AccountingPeriod {
  id              String                 @id @default(uuid())
  periodKey       String
  branchId        String
  legalEntityCode String
  status          AccountingPeriodStatus @default(OPEN)
  openedAt        DateTime               @default(now())
  closedAt        DateTime?

  branch         Branch          @relation(fields: [branchId], references: [id])
  legalEntity    LegalEntity     @relation(fields: [legalEntityCode], references: [code])
  vouchers       Voucher[]
  journalEntries JournalEntry[]
  closeEvidence  AccountingPeriodCloseEvidence[]
  reopenEvidence AccountingPeriodReopenEvidence[]
  reopenRequests AccountingPeriodReopenRequest[]

  @@unique([legalEntityCode, periodKey])
  @@index([branchId])
}

/// Immutable HARD-close audit record (Phase 20D/21A). Append-only — one row per successful HARD close.
model AccountingPeriodCloseEvidence {
  id        String @id @default(uuid())
  periodId  String
  branchId  String
  periodKey String

  closeMode String
  closedAt  DateTime

  closedByStaffId String
  closedByName    String
  closedByRole    String

  readinessStatus          String
  gatePolicyKey            String  @default("default")
  reconciliationSnapshotId String?
  priorSnapshotId          String?

  payloadVersion Int  @default(1)
  payload        Json

  createdAt DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, closedAt(sort: Desc)])
  @@index([branchId, periodKey])
  @@index([closedAt(sort: Desc)])
}

/// Immutable reopen audit record (Phase 21A). Actor fields are point-in-time snapshots — no Staff FK.
model AccountingPeriodReopenEvidence {
  id        String @id @default(uuid())
  periodId  String
  branchId  String
  periodKey String

  fromStatus String
  toStatus   String
  reopenedAt DateTime

  reopenedByStaffId String
  reopenedByName    String
  reopenedByRole    String

  reason String

  closeEvidenceId String?

  payloadVersion Int  @default(1)
  payload        Json

  createdAt DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, reopenedAt(sort: Desc)])
  @@index([branchId, periodKey])
}

/// Reopen approval workflow request (Phase 21B). Mutable until terminal status; execution creates reopen evidence.
model AccountingPeriodReopenRequest {
  id        String @id @default(uuid())
  requestNo String @unique
  periodId  String
  branchId  String
  periodKey String

  fromStatus String
  toStatus   String
  reason     String

  status AccountingPeriodReopenRequestStatus @default(PENDING)

  requestedAt        DateTime
  requestedByStaffId String
  requestedByName    String
  requestedByRole    String

  approvedAt        DateTime?
  approvedByStaffId String?
  approvedByName    String?
  approvedByRole    String?
  approvalNote      String?

  rejectedAt        DateTime?
  rejectedByStaffId String?
  rejectedByName    String?
  rejectedByRole    String?
  rejectionNote     String?

  cancelledAt        DateTime?
  cancelledByStaffId String?
  cancelledByName    String?
  cancelledByRole    String?

  executedAt       DateTime?
  reopenEvidenceId String?

  closeEvidenceId String?
  policyKey       String @default("default")
  payloadVersion  Int    @default(1)
  payload         Json

  createdAt DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, status])
  @@index([periodId, requestedAt(sort: Desc)])
  @@index([branchId, periodKey])
}

model Voucher {
  id              String        @id @default(uuid())
  voucherNo       String        @unique
  date            DateTime
  status          VoucherStatus @default(DRAFT)
  branchId        String
  legalEntityCode String
  periodId        String
  refType         String
  refId           String
  refNo           String?
  description     String?
  postedAt        DateTime?
  createdAt       DateTime      @default(now())

  branch       Branch           @relation(fields: [branchId], references: [id])
  legalEntity  LegalEntity      @relation(fields: [legalEntityCode], references: [code])
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  lines                    VoucherLine[]
  journalEntry             JournalEntry?
  manualJournalEntryPosted ManualJournalEntry?
  paymentVoucherPosted     PaymentVoucher?
  pettyCashVoucherPosted   PettyCashVoucher?
  revenueVoucherPosted     RevenueVoucher?

  @@unique([refType, refId])
  @@index([branchId, date])
  @@index([legalEntityCode, date])
  @@index([legalEntityCode, branchId, date])
}

model VoucherLine {
  /// Staging / trace layer tied to the voucher; not the immutable GL.
  id          String  @id @default(uuid())
  voucherId   String
  lineNo      Int
  glAccountId String
  debit       Decimal @default(0) @db.Decimal(18, 2)
  credit      Decimal @default(0) @db.Decimal(18, 2)
  memo        String?

  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  glAccount GlAccount @relation(fields: [glAccountId], references: [id])

  @@index([voucherId])
}

model JournalEntry {
  id              String   @id @default(uuid())
  voucherId       String   @unique
  date            DateTime
  branchId        String
  legalEntityCode String
  periodId        String
  postedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  /// Set on reversal journals only — points to the original posted journal.
  reversalOfJournalEntryId String? @unique

  voucher     Voucher          @relation(fields: [voucherId], references: [id])
  legalEntity LegalEntity      @relation(fields: [legalEntityCode], references: [code])
  period      AccountingPeriod @relation(fields: [periodId], references: [id])
  lines                    JournalEntryLine[]
  reverses                 JournalEntry?       @relation("JournalReversal", fields: [reversalOfJournalEntryId], references: [id])
  reversedBy               JournalEntry?       @relation("JournalReversal")
  manualJournalEntryPosted ManualJournalEntry? @relation("ManualJournalPosted")
  paymentVoucherPosted     PaymentVoucher?     @relation("PaymentVoucherPosted")
  pettyCashVoucherPosted   PettyCashVoucher?   @relation("PettyCashVoucherPosted")
  revenueVoucherPosted     RevenueVoucher?     @relation("RevenueVoucherPosted")
  manualJournalEntryReversal ManualJournalEntry? @relation("ManualJournalReversal")

  @@index([branchId, periodId, date])
  @@index([date])
  @@index([legalEntityCode, periodId, date])
  @@index([legalEntityCode, date])
}

model JournalEntryLine {
  /// Immutable general-ledger line (posted journal).
  id             String  @id @default(uuid())
  journalEntryId String
  lineNo         Int
  glAccountId    String
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit          Decimal @default(0) @db.Decimal(18, 2)
  memo           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id])

  @@index([journalEntryId])
}

/// Finance operational document — workflow layer before GL post (Phase 17A).
/// Document numbers: see docs/99_ASA_HANDBOOK.md Finance Vocabulary.
model ManualJournalEntry {
  id               String                   @id @default(uuid())
  entryNo          String                   @unique
  entryType        ManualJournalEntryType
  status           ManualJournalEntryStatus @default(DRAFT)
  branchId         String
  legalEntityCode  String
  entryDate        DateTime
  description      String?
  refNo            String?
  createdByStaffId String

  submittedAt         DateTime?
  submittedByStaffId  String?
  confirmedAt         DateTime?
  confirmedByStaffId  String?
  postedAt            DateTime?
  postedByStaffId     String?
  cancelledAt         DateTime?
  cancelledByStaffId  String?
  cancelReason        String? @db.Text

  postedVoucherId          String? @unique
  postedJournalEntryId     String? @unique
  reversalJournalEntryId   String? @unique

  /// Immutable PDF snapshot pathname (filesystem relative path or Blob pathname). Set once on POST.
  pdfPath        String?
  pdfBlobUrl     String?
  pdfGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch               Branch       @relation(fields: [branchId], references: [id])
  legalEntity          LegalEntity  @relation(fields: [legalEntityCode], references: [code])
  postedVoucher        Voucher?     @relation(fields: [postedVoucherId], references: [id])
  postedJournalEntry   JournalEntry? @relation("ManualJournalPosted", fields: [postedJournalEntryId], references: [id])
  reversalJournalEntry JournalEntry? @relation("ManualJournalReversal", fields: [reversalJournalEntryId], references: [id])
  lines                ManualJournalEntryLine[]

  @@index([branchId, entryDate])
  @@index([legalEntityCode, entryDate])
  @@index([legalEntityCode, entryType, status])
  @@index([status, entryDate])
}

model ManualJournalEntryLine {
  id                   String  @id @default(uuid())
  manualJournalEntryId String
  lineNo               Int
  glAccountId          String
  debit                Decimal @default(0) @db.Decimal(18, 2)
  credit               Decimal @default(0) @db.Decimal(18, 2)
  memo                 String?

  manualJournalEntry ManualJournalEntry @relation(fields: [manualJournalEntryId], references: [id], onDelete: Cascade)
  glAccount          GlAccount          @relation(fields: [glAccountId], references: [id])

  @@unique([manualJournalEntryId, lineNo])
  @@index([manualJournalEntryId])
}

/// Payment Voucher — outbound disbursement operational document (Phase F1C).
/// Document numbers: PAV-YYnnnn — see docs/99_ASA_HANDBOOK.md and FINANCE_PAY_DOCUMENT_DESIGN.md.
model PaymentVoucher {
  id               String               @id @default(uuid())
  entryNo          String               @unique
  status           PaymentVoucherStatus @default(DRAFT)
  branchId         String
  legalEntityCode  String
  entryDate        DateTime
  payFromAccountId String
  payeeName        String
  refNo            String?
  chequeNo         String?
  description      String?
  totalAmount      Decimal              @default(0) @db.Decimal(18, 2)
  createdByStaffId String

  submittedAt         DateTime?
  submittedByStaffId  String?
  confirmedAt         DateTime?
  confirmedByStaffId  String?
  postedAt            DateTime?
  postedByStaffId     String?
  cancelledAt         DateTime?
  cancelledByStaffId  String?
  cancelReason        String? @db.Text

  postedVoucherId      String? @unique
  postedJournalEntryId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch               Branch       @relation(fields: [branchId], references: [id])
  legalEntity          LegalEntity  @relation(fields: [legalEntityCode], references: [code])
  payFromAccount       GlAccount    @relation("PaymentVoucherPayFrom", fields: [payFromAccountId], references: [id])
  postedVoucher        Voucher?     @relation(fields: [postedVoucherId], references: [id])
  postedJournalEntry   JournalEntry? @relation("PaymentVoucherPosted", fields: [postedJournalEntryId], references: [id])
  lines                PaymentVoucherLine[]

  @@index([branchId, entryDate])
  @@index([legalEntityCode, entryDate])
  @@index([legalEntityCode, status])
  @@index([status, entryDate])
}

model PaymentVoucherLine {
  id               String  @id @default(uuid())
  paymentVoucherId String
  lineNo           Int
  glAccountId      String
  debit            Decimal @default(0) @db.Decimal(18, 2)
  credit           Decimal @default(0) @db.Decimal(18, 2)
  memo             String?

  paymentVoucher PaymentVoucher @relation(fields: [paymentVoucherId], references: [id], onDelete: Cascade)
  glAccount      GlAccount      @relation(fields: [glAccountId], references: [id])

  @@unique([paymentVoucherId, lineNo])
  @@index([paymentVoucherId])
}

