  fromDate  DateTime?
  toDate    DateTime?
  periodKey String?

  label String?
  note  String? @db.Text

  checkedSales          Int
  checkedStockDocuments Int
  issueCount            Int
  dashboardRowCount     Int
  matchedCount          Int
  varianceCount         Int
  totalVarianceAmount   Decimal @db.Decimal(18, 2)

  payloadVersion Int @default(1)

  inventoryResult Json
  salesResult       Json
  dashboardRows     Json
  issuesPayload     Json

