generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// DATABASE_URL: see prisma.config.ts datasource.url (Prisma 7 — url not allowed in schema file)
datasource db {
  provider = "postgresql"
}

enum Role {
  HO_FINANCE
  HO_ADMIN
  HO_OPERATIONS
  SH_STAFF
}

enum BranchType {
  HO
  SH
}

enum ProductType {
  TRACKED
  CONSUMABLE
}

enum DocType {
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  PERFORMANCE
}

enum DocStatus {
  DRAFT
  SUBMITTED
  SHIPPED
  CONFIRMED
  RECEIVED
  POSTED
  TRANSFERRED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
}

enum RefundKind {
  SALE_LINKED
  GOODWILL
}

enum PaymentMethod {
  CASH
  CARD
  QR
  TRANSFER
  OTHER
}

enum LedgerSkipReason {
  CONSUMABLE
}

enum MarketType {
  SERVICES
  OUTSIDERS
}

enum PricingClass {
  MATERIAL
  MACHINERY
  CONSUMABLE
}

enum RoundingMode {
  NONE
  CENT_01
  CENT_05
  BAHT_1
  BAHT_10
  BAHT_100
}

model Branch {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  type      BranchType @default(SH)
  address   String?
  phone     String?
  /// HO999 = company tax ID; SH* = POS machine / approval ID (see receipt print rules).
  taxId     String?
  isActive  Boolean    @default(true)
  deleted   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  staffs            Staff[]
  stocks            Stock[]
  stockLayers       StockLayer[]
  stockTransactions StockTransaction[]
  stockDocuments    StockDocument[]
  sales             Sale[]
  refunds           Refund[]
  vouchers          Voucher[]
  accountingPeriods        AccountingPeriod[]
  reconciliationSnapshots  ReconciliationSnapshot[]
  salesTargets             BranchSalesTarget[]
}

/// HO monthly sales target per shop branch — daily split uses weekPattern Mon..Sun weights.
model BranchSalesTarget {
  id           String   @id @default(uuid())
  branchId     String
  year         Int
  month        Int
  monthlyTotal Decimal  @db.Decimal(18, 2)
  weekPattern  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year, month])
  @@index([branchId, year, month])
}

model Staff {
  id        String   @id @default(cuid())
  staffId   String   @unique
  password  String
  name      String
  role      Role
  branchId  String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch                         Branch                   @relation(fields: [branchId], references: [id])
  reconciliationSnapshotsCreated ReconciliationSnapshot[]
}

model Product {
  id          String      @id @default(uuid())
  groupCode   Int
  typeCode    Int
  runningCode Int
  code        String      @unique
  name        String
  productType ProductType @default(TRACKED)
  deleted     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  referenceStocks    ReferenceStock[]
  stocks             Stock[]
  stockLayers        StockLayer[]
  stockTransactions  StockTransaction[]
  stockDocumentLines StockDocumentLine[]
  saleItems          SaleItem[]
  sellingPrices      SellingPrice[]

  @@unique([groupCode, typeCode, runningCode])
}

model PricingPolicy {
  id            String       @id @default(uuid())
  marketType    MarketType
  pricingClass  PricingClass
  markupPercent Decimal      @db.Decimal(5, 4)
  roundingMode  RoundingMode
  threshold     Decimal?     @db.Decimal(18, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())

  @@index([marketType, pricingClass, effectiveTo])
  @@index([marketType, pricingClass, effectiveFrom])
}

model SellingPrice {
  id            String    @id @default(uuid())
  productId     String
  price         Decimal   @db.Decimal(18, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveTo])
  @@index([productId, effectiveFrom])
}

model ReferenceStock {
  id           String   @id @default(uuid())
  hookGroup    String
  hookNo       Int
  supplierCode String
  productCode  String
  productGroup String?
  productId    String
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, hookGroup, hookNo])
}

model Stock {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  qty       Int      @default(0)
  avgCost   Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model StockLayer {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  qty       Int
  qtyRemain Int
  unitCost  Decimal  @db.Decimal(18, 6)
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model StockTransaction {
  id          String   @id @default(uuid())
  branchId    String
  productId   String
  date        DateTime
  qtyIn       Int      @default(0)
  qtyOut      Int      @default(0)
  unitCost    Decimal  @db.Decimal(18, 6)
  beforeQty   Int
  afterQty    Int
  beforeValue Decimal  @db.Decimal(18, 6)
  afterValue  Decimal  @db.Decimal(18, 6)
  refType     String
  refId       String
  refLineId   String
  documentId  String?
  createdAt   DateTime @default(now())

  branch   Branch         @relation(fields: [branchId], references: [id])
  product  Product        @relation(fields: [productId], references: [id])
  document StockDocument? @relation(fields: [documentId], references: [id])
}

model StockDocument {
  id                 String    @id @default(uuid())
  refNo              String    @unique
  docType            DocType
  status             DocStatus @default(DRAFT)
  date               DateTime
  branchId           String
  periodMonth        String?
  fromLocId          String?
  toLocId            String?
  submittedAt        DateTime?
  confirmedAt        DateTime?
  postedAt           DateTime?
  createdByStaffId   String?
  confirmedByStaffId String?
  postedByStaffId    String?
  cancelledAt        DateTime?
  cancelledByStaffId String?
  cancelReason       String?   @db.Text
  createdAt          DateTime  @default(now())

  branch       Branch              @relation(fields: [branchId], references: [id])
  lines        StockDocumentLine[]
  transactions StockTransaction[]
}

model StockDocumentLine {
  id                 String @id @default(uuid())
  documentId         String
  productId          String
  qty                Int
  endingQty          Int?
  reviewPostingDelta Int?

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model DocumentCounter {
  id      String @id @default(uuid())
  docType String
  shopId  String
  period  String
  running Int    @default(0)

  @@unique([docType, shopId, period])
}

model Sale {
  id        String     @id @default(uuid())
  branchId  String
  staffId   String?
  total     Decimal    @db.Decimal(18, 2)
  status    SaleStatus @default(COMPLETED)
  createdAt DateTime   @default(now())

  branch  Branch     @relation(fields: [branchId], references: [id])
  items   SaleItem[]
  payment Payment?
  receipt Receipt?
  refunds Refund[]
}

model SaleItem {
  id                  String             @id @default(uuid())
  saleId              String
  productId           String
  productType         ProductType
  qty                 Int
  unitPrice           Decimal            @db.Decimal(18, 2)
  lineTotal           Decimal            @db.Decimal(18, 2)
  ledgerSkippedReason LedgerSkipReason?
  createdAt           DateTime           @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String        @unique
  method    PaymentMethod
  amount    Decimal       @db.Decimal(18, 2)
  change    Decimal       @default(0) @db.Decimal(18, 2)
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Receipt {
  id        String   @id @default(uuid())
  saleId    String   @unique
  branchId  String
  receiptNo String
  issuedAt  DateTime @default(now())

  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refundsAsOriginal Refund[] @relation("OriginalReceipt")

  @@unique([branchId, receiptNo])
}

model Refund {
  id                 String     @id @default(uuid())
  refundNo           String     @unique
  kind               RefundKind
  saleId             String?
  branchId           String
  staffId            String?
  originalReceiptId  String?
  amount             Decimal    @db.Decimal(18, 2)
  reasonCode         String?
  reason             String?    @db.Text
  createdAt          DateTime   @default(now())

  sale            Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  branch          Branch   @relation(fields: [branchId], references: [id])
  originalReceipt Receipt? @relation("OriginalReceipt", fields: [originalReceiptId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([branchId, createdAt])
  @@index([kind])
}

/// Singleton receipt layout/footer (id = "default").
model ReceiptPrintSettings {
  id                      String   @id @default("default")
  companyDisplayName      String?
  footerLine1             String?
  footerLine2             String?
  footerLine3             String?
  footerLine4             String?
  footerLine5             String?
  showAbbreviatedTaxTitle Boolean  @default(true)
  showVatIncludedMessage  Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}
enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherStatus {
  DRAFT
  POSTED
  VOIDED
}

enum AccountingPeriodStatus {
  /// Posting allowed
  OPEN
  /// Posting blocked; soft close (reopen workflow deferred)
  SOFT_CLOSED
  /// Posting blocked; hard close / locked
  HARD_CLOSED
}

enum AccountingPeriodReopenRequestStatus {
  PENDING
  REJECTED
  CANCELLED
  EXECUTED
}

model GlAccount {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  accountType GlAccountType
  isActive    Boolean        @default(true)
  deleted     Boolean        @default(false)
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent            GlAccount?         @relation("GlAccountHierarchy", fields: [parentId], references: [id])
  children          GlAccount[]        @relation("GlAccountHierarchy")
  voucherLines      VoucherLine[]
  journalEntryLines JournalEntryLine[]
}

model AccountingPeriod {
  id        String                 @id @default(uuid())
  periodKey String
  branchId  String
  status    AccountingPeriodStatus @default(OPEN)
  openedAt  DateTime               @default(now())
  closedAt  DateTime?

  branch         Branch          @relation(fields: [branchId], references: [id])
  vouchers       Voucher[]
  journalEntries JournalEntry[]
  closeEvidence  AccountingPeriodCloseEvidence[]
  reopenEvidence AccountingPeriodReopenEvidence[]
  reopenRequests AccountingPeriodReopenRequest[]

  @@unique([branchId, periodKey])
}

/// Immutable HARD-close audit record (Phase 20D/21A). Append-only — one row per successful HARD close.
model AccountingPeriodCloseEvidence {
  id        String @id @default(uuid())
  periodId  String
  branchId  String
  periodKey String

  closeMode String
  closedAt  DateTime

  closedByStaffId String
  closedByName    String
  closedByRole    String

  readinessStatus          String
  gatePolicyKey            String  @default("default")
  reconciliationSnapshotId String?
  priorSnapshotId          String?

  payloadVersion Int  @default(1)
  payload        Json

  createdAt DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, closedAt(sort: Desc)])
  @@index([branchId, periodKey])
  @@index([closedAt(sort: Desc)])
}

/// Immutable reopen audit record (Phase 21A). Actor fields are point-in-time snapshots — no Staff FK.
model AccountingPeriodReopenEvidence {
  id        String @id @default(uuid())
  periodId  String
  branchId  String
  periodKey String

  fromStatus String
  toStatus   String
  reopenedAt DateTime

  reopenedByStaffId String
  reopenedByName    String
  reopenedByRole    String

  reason String

  closeEvidenceId String?

  payloadVersion Int  @default(1)
  payload        Json

  createdAt DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, reopenedAt(sort: Desc)])
  @@index([branchId, periodKey])
}

/// Reopen approval workflow request (Phase 21B). Mutable until terminal status; execution creates reopen evidence.
model AccountingPeriodReopenRequest {
  id        String @id @default(uuid())
  requestNo String @unique
  periodId  String
  branchId  String
  periodKey String

  fromStatus String
  toStatus   String
  reason     String

  status AccountingPeriodReopenRequestStatus @default(PENDING)

  requestedAt        DateTime
  requestedByStaffId String
  requestedByName    String
  requestedByRole    String

  approvedAt        DateTime?
  approvedByStaffId String?
  approvedByName    String?
  approvedByRole    String?
  approvalNote      String?

  rejectedAt        DateTime?
  rejectedByStaffId String?
  rejectedByName    String?
  rejectedByRole    String?
  rejectionNote     String?

  cancelledAt        DateTime?
  cancelledByStaffId String?
  cancelledByName    String?
  cancelledByRole    String?

  executedAt       DateTime?
  reopenEvidenceId String?

  closeEvidenceId String?
  policyKey       String @default("default")
  payloadVersion  Int    @default(1)
  payload         Json

  createdAt DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, status])
  @@index([periodId, requestedAt(sort: Desc)])
  @@index([branchId, periodKey])
}

model Voucher {
  id          String        @id @default(uuid())
  voucherNo   String   @unique
  date        DateTime
  status      VoucherStatus @default(DRAFT)
  branchId    String
  periodId    String
  refType     String
  refId       String
  refNo       String?
  description String?
  postedAt    DateTime?
  createdAt   DateTime      @default(now())

  branch       Branch           @relation(fields: [branchId], references: [id])
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  lines        VoucherLine[]
  journalEntry JournalEntry?

  @@unique([refType, refId])
  @@index([branchId, date])
}

model VoucherLine {
  /// Staging / trace layer tied to the voucher; not the immutable GL.
  id          String  @id @default(uuid())
  voucherId   String
  lineNo      Int
  glAccountId String
  debit       Decimal @default(0) @db.Decimal(18, 2)
  credit      Decimal @default(0) @db.Decimal(18, 2)
  memo        String?

  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  glAccount GlAccount @relation(fields: [glAccountId], references: [id])

  @@index([voucherId])
}

model JournalEntry {
  id        String   @id @default(uuid())
  voucherId String   @unique
  date      DateTime
  branchId  String
  periodId  String
  postedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  voucher Voucher          @relation(fields: [voucherId], references: [id])
  period  AccountingPeriod @relation(fields: [periodId], references: [id])
  lines   JournalEntryLine[]
}

model JournalEntryLine {
  /// Immutable general-ledger line (posted journal).
  id             String  @id @default(uuid())
  journalEntryId String
  lineNo         Int
  glAccountId    String
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit          Decimal @default(0) @db.Decimal(18, 2)
  memo           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id])

  @@index([journalEntryId])
}

enum ReconciliationSnapshotKind {
  MANUAL
}

model ReconciliationSnapshot {
  id   String                     @id @default(uuid())
  kind ReconciliationSnapshotKind @default(MANUAL)

  branchId  String?
  fromDate  DateTime?
  toDate    DateTime?
  periodKey String?

  label String?
  note  String? @db.Text

  checkedSales          Int
  checkedStockDocuments Int
  issueCount            Int
  dashboardRowCount     Int
  matchedCount          Int
  varianceCount         Int
  totalVarianceAmount   Decimal @db.Decimal(18, 2)

  payloadVersion Int @default(1)

  inventoryResult Json
  salesResult       Json
  dashboardRows     Json
  issuesPayload     Json

  createdAt        DateTime @default(now())
  createdByStaffId String

  branch    Branch? @relation(fields: [branchId], references: [id])
  createdBy Staff   @relation(fields: [createdByStaffId], references: [id])

  @@index([branchId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
