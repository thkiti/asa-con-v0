generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id                      String                   @id @default(uuid())
  code                    String                   @unique
  name                    String
  type                    BranchType               @default(SH)
  isActive                Boolean                  @default(true)
  deleted                 Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  address                 String?
  phone                   String?
  /// HO999 = company tax ID; SH* = POS machine / approval ID (see receipt print rules).
  taxId                   String?
  accountingPeriods       AccountingPeriod[]
  salesTargets            BranchSalesTarget[]
  collectorReports        CollectorReport[]
  invoiceVouchers         InvoiceVoucher[]
  manualJournalEntries    ManualJournalEntry[]
  paymentVouchers         PaymentVoucher[]
  pettyCashVouchers       PettyCashVoucher[]
  reconciliationSnapshots ReconciliationSnapshot[]
  refunds                 Refund[]
  revenueVouchers         RevenueVoucher[]
  sales                   Sale[]
  staffs                  Staff[]
  stocks                  Stock[]
  stockDocuments          StockDocument[]
  stockLayers             StockLayer[]
  stockTransactions       StockTransaction[]
  vouchers                Voucher[]
  workTimeEntries         WorkTimeEntry[]
}

/// HO monthly sales target per shop branch โ€” daily split uses weekPattern Mon..Sun weights.
model BranchSalesTarget {
  id           String   @id @default(uuid())
  branchId     String
  year         Int
  month        Int
  monthlyTotal Decimal  @db.Decimal(18, 2)
  weekPattern  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year, month])
  @@index([branchId, year, month])
}

/// POS staff daily clock-in/out โ€” one row per branch + staff + Bangkok calendar date.
model WorkTimeEntry {
  id         String    @id @default(uuid())
  branchId   String
  /// Staff login code (Staff.staffId), same as Sale.staffId.
  staffId    String
  /// Bangkok calendar date YYYY-MM-DD.
  workDate   String
  clockInAt  DateTime?
  clockOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, staffId, workDate])
  @@index([branchId, staffId, workDate])
}

model Staff {
  id                             String                   @id @default(cuid())
  staffId                        String                   @unique
  password                       String
  name                           String
  role                           Role
  branchId                       String
  deleted                        Boolean                  @default(false)
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  posCanCollect                  Boolean                  @default(false)
  /// เธฅเนเธญเธเธญเธดเธ POS เธ—เธตเนเธชเธฒเธเธฒเธฃเนเธฒเธเธญเธทเนเธเนเธ”เน (เธเธเธฑเธเธเธฒเธเนเธ—เธ)
  allowAnyBranchLogin            Boolean                  @default(false)
  reconciliationSnapshotsCreated ReconciliationSnapshot[]
  branch                         Branch                   @relation(fields: [branchId], references: [id])
}

model Product {
  id                 String              @id @default(uuid())
  groupCode          Int
  typeCode           Int
  runningCode        Int
  code               String              @unique
  name               String
  productType        ProductType         @default(TRACKED)
  deleted            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  referenceStocks    ReferenceStock[]
  saleItems          SaleItem[]
  sellingPrices      SellingPrice[]
  stocks             Stock[]
  stockDocumentLines StockDocumentLine[]
  stockLayers        StockLayer[]
  stockTransactions  StockTransaction[]

  @@unique([groupCode, typeCode, runningCode])
}

model PricingPolicy {
  id            String       @id @default(uuid())
  marketType    MarketType
  pricingClass  PricingClass
  markupPercent Decimal      @db.Decimal(5, 4)
  roundingMode  RoundingMode
  threshold     Decimal?     @db.Decimal(18, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())

  @@index([marketType, pricingClass, effectiveTo])
  @@index([marketType, pricingClass, effectiveFrom])
}

model SellingPrice {
  id            String    @id @default(uuid())
  productId     String
  price         Decimal   @db.Decimal(18, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveTo])
  @@index([productId, effectiveFrom])
}

model ReferenceStock {
  id           String   @id @default(uuid())
  hookGroup    String
  hookNo       Int
  supplierCode String
  productCode  String
  productGroup String?
  productId    String
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([productId, hookGroup, hookNo])
}

model Stock {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  qty       Int      @default(0)
  avgCost   Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model StockLayer {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  qty       Int
  qtyRemain Int
  unitCost  Decimal  @db.Decimal(18, 6)
  refType   String?
  refId     String?
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model StockTransaction {
  id          String         @id @default(uuid())
  branchId    String
  productId   String
  date        DateTime
  qtyIn       Int            @default(0)
  qtyOut      Int            @default(0)
  unitCost    Decimal        @db.Decimal(18, 6)
  beforeQty   Int
  afterQty    Int
  beforeValue Decimal        @db.Decimal(18, 6)
  afterValue  Decimal        @db.Decimal(18, 6)
  refType     String
