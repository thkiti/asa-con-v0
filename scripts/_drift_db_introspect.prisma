model StockDocumentLine {
  id                 String        @id @default(uuid())
  documentId         String
  productId          String
  qty                Int
  endingQty          Int?
  reviewPostingDelta Int?
  document           StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id])
}

model DocumentCounter {
  id      String @id @default(uuid())
  docType String
  shopId  String
  period  String
  running Int    @default(0)

  @@unique([docType, shopId, period])
}

model Sale {
  id                   String               @id @default(uuid())
  branchId             String
  staffId              String?
  total                Decimal              @db.Decimal(18, 2)
  status               SaleStatus           @default(COMPLETED)
  createdAt            DateTime             @default(now())
  /// Net of VAT at checkout โ€” snapshotted from effective tax policy.
  netAmount            Decimal?             @db.Decimal(18, 2)
  /// GL output VAT account used at checkout posting.
  outputVatAccountCode String?
  /// Tax policy code, e.g. VAT_OUTPUT_STANDARD.
  taxCode              String?
  /// Output VAT amount at checkout โ€” snapshotted for stable receipt/finance history.
  vatAmount            Decimal?             @db.Decimal(18, 2)
  /// Tax rate in basis points (700 = 7.00%) applied at checkout.
  vatRateBps           Int?
  legacySaleReference  LegacySaleReference?
  payment              Payment?
  paymentEvidence      PaymentEvidence?
  receipt              Receipt?
  refunds              Refund[]
  branch               Branch               @relation(fields: [branchId], references: [id])
  items                SaleItem[]
}

model SaleItem {
  id                  String            @id @default(uuid())
  saleId              String
  productId           String
  productType         ProductType
  qty                 Int
  unitPrice           Decimal           @db.Decimal(18, 2)
  lineTotal           Decimal           @db.Decimal(18, 2)
  ledgerSkippedReason LedgerSkipReason?
  createdAt           DateTime          @default(now())
  product             Product           @relation(fields: [productId], references: [id])
  sale                Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id              String           @id @default(uuid())
  saleId          String           @unique
  method          PaymentMethod
  amount          Decimal          @db.Decimal(18, 2)
  change          Decimal          @default(0) @db.Decimal(18, 2)
  createdAt       DateTime         @default(now())
  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentEvidence PaymentEvidence?
}

/// Central vault file row โ€” bytes metadata and storage location.
model DocumentArchive {
  id              String                @id @default(uuid())
  /// Legacy pilot โ€” receipt attach upsert; mirrored in DocumentArchiveLink from Phase 4.
  documentType    DocumentArchiveType
  documentId      String
  documentNo      String
  legalEntityId   String?
  branchId        String?
  /// Legacy storage paths โ€” dual column with storagePath/storageUrl until Phase 4 bridge.
  pdfPath         String?
  pdfBlobUrl      String?
  snapshotJson    Json?
  snapshotVersion Int
  status          DocumentArchiveStatus @default(PENDING)
  generatedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  receipt         Receipt?

  @@unique([documentType, documentId])
  @@index([status])
  @@index([branchId, documentType, createdAt])
  @@index([documentType, documentNo])
}

model Receipt {
  id                String           @id @default(uuid())
  saleId            String           @unique
  branchId          String
  receiptNo         String
  issuedAt          DateTime         @default(now())
  documentArchiveId String?          @unique
  pdfBlobUrl        String?
  pdfGeneratedAt    DateTime?
  pdfPath           String?
  paymentEvidence   PaymentEvidence?
  documentArchive   DocumentArchive? @relation(fields: [documentArchiveId], references: [id])
  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refundsAsOriginal Refund[]         @relation("OriginalReceipt")

  @@unique([branchId, receiptNo])
}

/// Bank-transfer slip evidence โ€” keyed by receiptNo.
model PaymentEvidence {
  id           String                @id @default(uuid())
  branchId     String
  receiptNo    String
  receiptId    String                @unique
  saleId       String                @unique
  paymentId    String                @unique
  status       PaymentEvidenceStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  blobPathname String?
  blobUrl      String?
  byteSize     Int?
  mimeType     String                @default("image/jpeg")
  uploadError  String?
  uploadedAt   DateTime?
  payment      Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receipt      Receipt               @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sale         Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([branchId, receiptNo])
  @@index([branchId, status])
}

model Refund {
  id                String     @id @default(uuid())
  kind              RefundKind
  saleId            String?
  branchId          String
  staffId           String?
  originalReceiptId String?
  amount            Decimal    @db.Decimal(18, 2)
  reason            String?
  createdAt         DateTime   @default(now())
  reasonCode        String?
  refundNo          String     @unique
  branch            Branch     @relation(fields: [branchId], references: [id])
  originalReceipt   Receipt?   @relation("OriginalReceipt", fields: [originalReceiptId], references: [id])
  sale              Sale?      @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([branchId, createdAt])
  @@index([kind])
}

/// POS collector ticket โ€” persisted COL-{branch}-{YYYYMM}-{seq} report snapshot.
model CollectorReport {
  id            String            @id @default(uuid())
  collectNo     String            @unique
  branchId      String
  staffId       String
  reportJson    Json
  createdAt     DateTime          @default(now())
  branch        Branch            @relation(fields: [branchId], references: [id])
  payInEvidence PosPayInEvidence?

  @@index([branchId, createdAt])
}

/// Bank PAY-IN slip evidence for PSV-BANK-DEP โ€” keyed by collector report.
model PosPayInEvidence {
  id                   String                @id @default(uuid())
  collectorReportId    String                @unique
  collectNo            String
  branchId             String
  status               PaymentEvidenceStatus @default(PENDING)
  blobPathname         String?
  blobUrl              String?
  mimeType             String                @default("image/jpeg")
  byteSize             Int?
  originalFilename     String?
  uploadedAt           DateTime?
  uploadedByStaffId    String?
  bankDepositDate      DateTime?
  bankAccountCode      String                @default("1021")
  bankDepositVoucherId String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  collectorReport      CollectorReport       @relation(fields: [collectorReportId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
  @@index([collectNo])
}

/// Singleton receipt layout/footer (id = "default").
/// P2B drop deferred โ€” keep until ThermalDocumentLayout backfill is verified in DB.
model ReceiptPrintSettings {
  id                      String   @id @default("default")
  companyDisplayName      String?
  footerLine1             String?
  footerLine2             String?
  footerLine3             String?
  footerLine4             String?
  footerLine5             String?
  showAbbreviatedTaxTitle Boolean  @default(true)
  showVatIncludedMessage  Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

/// Thermal 80mm layout โ€” one row per document type.
model ThermalDocumentLayout {
  documentType            ThermalDocumentType @id
  headerLine1             String?
  headerLine2             String?
  headerLine3             String?
  footerLine1             String?
  footerLine2             String?
  footerLine3             String?
  footerLine4             String?
  footerLine5             String?
  showAbbreviatedTaxTitle Boolean             @default(true)
  showVatIncludedMessage  Boolean             @default(true)
  updatedAt               DateTime            @updatedAt
  footerBlockBold         Boolean             @default(true)
  footerBlockText         String?
  footerFontSize          String              @default("12")
  headerBlockBold         Boolean             @default(true)
  headerBlockText         String?
  headerFontSize          String              @default("12")
  subHeaderBlockBold      Boolean             @default(false)
  subHeaderBlockText      String?
  subHeaderFontSize       String              @default("12")
  infoBlockBold           Boolean             @default(true)
  infoBlockFontSize       String              @default("14")
}

model GlAccount {
  id                        String                   @id @default(uuid())
  code                      String                   @unique
  name                      String
  accountType               GlAccountType
  isActive                  Boolean                  @default(true)
  deleted                   Boolean                  @default(false)
  parentId                  String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  parent                    GlAccount?               @relation("GlAccountHierarchy", fields: [parentId], references: [id])
  children                  GlAccount[]              @relation("GlAccountHierarchy")
  invoiceVoucherLines       InvoiceVoucherLine[]
  journalEntryLines         JournalEntryLine[]
  manualJournalEntryLines   ManualJournalEntryLine[]
  paymentVoucherPayFrom     PaymentVoucher[]         @relation("PaymentVoucherPayFrom")
  paymentVoucherLines       PaymentVoucherLine[]
  pettyCashVoucherPettyCash PettyCashVoucher[]       @relation("PettyCashVoucherPettyCash")
  pettyCashVoucherLines     PettyCashVoucherLine[]
  revenueVoucherReceiveTo   RevenueVoucher[]         @relation("RevenueVoucherReceiveTo")
  revenueVoucherLines       RevenueVoucherLine[]
  voucherLines              VoucherLine[]
}

model LegalEntity {
  code                 String               @id
  name                 String
  address              String?
  taxId                String?
  accountingPeriods    AccountingPeriod[]
  invoiceVouchers      InvoiceVoucher[]
  journalEntries       JournalEntry[]
  manualJournalEntries ManualJournalEntry[]
  paymentVouchers      PaymentVoucher[]
  pettyCashVouchers    PettyCashVoucher[]
  revenueVouchers      RevenueVoucher[]
  stockDocuments       StockDocument[]
  taxPolicies          TaxPolicy[]
  vouchers             Voucher[]
}

/// Effective-dated VAT/tax rate policy for finance and POS snapshotting.
model TaxPolicy {
  id                   String      @id @default(uuid())
  legalEntityCode      String
  taxCode              String
  /// Rate in basis points โ€” 700 = 7.00%.
  rateBps              Int
  inclusive            Boolean     @default(true)
  outputVatAccountCode String
  effectiveFrom        DateTime    @db.Date
  effectiveTo          DateTime?   @db.Date
  isActive             Boolean     @default(true)
  description          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  legalEntity          LegalEntity @relation(fields: [legalEntityCode], references: [code])

  @@index([legalEntityCode, taxCode, isActive])
  @@index([legalEntityCode, taxCode, effectiveFrom])
}

model AccountingPeriod {
  id              String                           @id @default(uuid())
  periodKey       String
  branchId        String
  status          AccountingPeriodStatus           @default(OPEN)
  openedAt        DateTime                         @default(now())
  closedAt        DateTime?
  legalEntityCode String
  branch          Branch                           @relation(fields: [branchId], references: [id])
  legalEntity     LegalEntity                      @relation(fields: [legalEntityCode], references: [code])
  closeEvidence   AccountingPeriodCloseEvidence[]
  reopenEvidence  AccountingPeriodReopenEvidence[]
  reopenRequests  AccountingPeriodReopenRequest[]
  journalEntries  JournalEntry[]
  vouchers        Voucher[]

  @@unique([legalEntityCode, periodKey])
  @@index([branchId])
}

/// Immutable HARD-close audit record (Phase 20D/21A). Append-only โ€” one row per successful HARD close.
model AccountingPeriodCloseEvidence {
  id                       String           @id @default(uuid())
  periodId                 String
  branchId                 String
  periodKey                String
  closeMode                String
  closedAt                 DateTime
  closedByStaffId          String
  closedByName             String
  closedByRole             String
  readinessStatus          String
  gatePolicyKey            String           @default("default")
  reconciliationSnapshotId String?
  priorSnapshotId          String?
  payloadVersion           Int              @default(1)
  payload                  Json
  createdAt                DateTime         @default(now())
  period                   AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, closedAt(sort: Desc)])
  @@index([branchId, periodKey])
  @@index([closedAt(sort: Desc)])
}

/// Immutable reopen audit record (Phase 21A). Actor fields are point-in-time snapshots โ€” no Staff FK.
model AccountingPeriodReopenEvidence {
  id                String           @id @default(uuid())
  periodId          String
  branchId          String
  periodKey         String
  fromStatus        String
  toStatus          String
  reopenedAt        DateTime
  reopenedByStaffId String
  reopenedByName    String
  reopenedByRole    String
  reason            String
  closeEvidenceId   String?
  payloadVersion    Int              @default(1)
  payload           Json
  createdAt         DateTime         @default(now())
  period            AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, reopenedAt(sort: Desc)])
  @@index([branchId, periodKey])
}

/// Reopen approval workflow request (Phase 21B). Mutable until terminal status; execution creates reopen evidence.
model AccountingPeriodReopenRequest {
  id                 String                              @id @default(uuid())
  requestNo          String                              @unique
  periodId           String
  branchId           String
  periodKey          String
  fromStatus         String
  toStatus           String
  reason             String
  status             AccountingPeriodReopenRequestStatus @default(PENDING)
  requestedAt        DateTime
  requestedByStaffId String
  requestedByName    String
  requestedByRole    String
  approvedAt         DateTime?
  approvedByStaffId  String?
  approvedByName     String?
  approvedByRole     String?
  approvalNote       String?
  rejectedAt         DateTime?
  rejectedByStaffId  String?
  rejectedByName     String?
  rejectedByRole     String?
  rejectionNote      String?
  cancelledAt        DateTime?
  cancelledByStaffId String?
  cancelledByName    String?
  cancelledByRole    String?
  executedAt         DateTime?
  reopenEvidenceId   String?
  closeEvidenceId    String?
  policyKey          String                              @default("default")
  payloadVersion     Int                                 @default(1)
  payload            Json
  createdAt          DateTime                            @default(now())
  period             AccountingPeriod                    @relation(fields: [periodId], references: [id])

  @@index([periodId, status])
  @@index([periodId, requestedAt(sort: Desc)])
  @@index([branchId, periodKey])
}

model Voucher {
  id                       String              @id @default(uuid())
  voucherNo                String              @unique
  date                     DateTime
  status                   VoucherStatus       @default(DRAFT)
  branchId                 String
  periodId                 String
  refType                  String
  refId                    String
  refNo                    String?
  description              String?
  postedAt                 DateTime?
  createdAt                DateTime            @default(now())
  legalEntityCode          String
  invoiceVoucherPosted     InvoiceVoucher?
  journalEntry             JournalEntry?
  manualJournalEntryPosted ManualJournalEntry?
  paymentVoucherPosted     PaymentVoucher?
  pettyCashVoucherPosted   PettyCashVoucher?
  revenueVoucherPosted     RevenueVoucher?
  branch                   Branch              @relation(fields: [branchId], references: [id])
  legalEntity              LegalEntity         @relation(fields: [legalEntityCode], references: [code])
  period                   AccountingPeriod    @relation(fields: [periodId], references: [id])
  lines                    VoucherLine[]

  @@unique([refType, refId])
  @@index([branchId, date])
  @@index([legalEntityCode, date])
  @@index([legalEntityCode, branchId, date])
}

model VoucherLine {
  /// Staging / trace layer tied to the voucher; not the immutable GL.
  id          String    @id @default(uuid())
  voucherId   String
  lineNo      Int
  glAccountId String
  debit       Decimal   @default(0) @db.Decimal(18, 2)
  credit      Decimal   @default(0) @db.Decimal(18, 2)
  memo        String?
  glAccount   GlAccount @relation(fields: [glAccountId], references: [id])
  voucher     Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

model JournalEntry {
  id                         String              @id @default(uuid())
  voucherId                  String              @unique
  date                       DateTime
  branchId                   String
  periodId                   String
  postedAt                   DateTime            @default(now())
  createdAt                  DateTime            @default(now())
  /// Set on reversal journals only โ€” points to the original posted journal.
  reversalOfJournalEntryId   String?             @unique
  legalEntityCode            String
  invoiceVoucherPosted       InvoiceVoucher?     @relation("InvoiceVoucherPosted")
  legalEntity                LegalEntity         @relation(fields: [legalEntityCode], references: [code])
  period                     AccountingPeriod    @relation(fields: [periodId], references: [id])
  reverses                   JournalEntry?       @relation("JournalReversal", fields: [reversalOfJournalEntryId], references: [id])
  reversedBy                 JournalEntry?       @relation("JournalReversal")
  voucher                    Voucher             @relation(fields: [voucherId], references: [id])
  lines                      JournalEntryLine[]
  manualJournalEntryPosted   ManualJournalEntry? @relation("ManualJournalPosted")
  manualJournalEntryReversal ManualJournalEntry? @relation("ManualJournalReversal")
  paymentVoucherPosted       PaymentVoucher?     @relation("PaymentVoucherPosted")
  pettyCashVoucherPosted     PettyCashVoucher?   @relation("PettyCashVoucherPosted")
  revenueVoucherPosted       RevenueVoucher?     @relation("RevenueVoucherPosted")

  @@index([branchId, periodId, date])
  @@index([date])
  @@index([legalEntityCode, periodId, date])
  @@index([legalEntityCode, date])
}

model JournalEntryLine {
  /// Immutable general-ledger line (posted journal).
  id             String       @id @default(uuid())
  journalEntryId String
  lineNo         Int
  glAccountId    String
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  memo           String?
  glAccount      GlAccount    @relation(fields: [glAccountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
}

/// Finance operational document โ€” workflow layer before GL post (Phase 17A).
/// Document numbers: see docs/99_ASA_HANDBOOK.md Finance Vocabulary.
model ManualJournalEntry {
  id                     String                   @id @default(uuid())
  entryNo                String                   @unique
  entryType              ManualJournalEntryType
  status                 ManualJournalEntryStatus @default(DRAFT)
  branchId               String
  legalEntityCode        String
  entryDate              DateTime
  description            String?
  refNo                  String?
  createdByStaffId       String
  submittedAt            DateTime?
  submittedByStaffId     String?
  confirmedAt            DateTime?
  confirmedByStaffId     String?
  postedAt               DateTime?
  postedByStaffId        String?
  cancelledAt            DateTime?
  cancelledByStaffId     String?
  cancelReason           String?
  postedVoucherId        String?                  @unique
  postedJournalEntryId   String?                  @unique
  reversalJournalEntryId String?                  @unique
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  /// Immutable PDF snapshot pathname (filesystem relative path or Blob pathname). Set once on POST.
  pdfPath                String?
  pdfGeneratedAt         DateTime?
  pdfBlobUrl             String?
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  legalEntity            LegalEntity              @relation(fields: [legalEntityCode], references: [code])
  postedJournalEntry     JournalEntry?            @relation("ManualJournalPosted", fields: [postedJournalEntryId], references: [id])
  postedVoucher          Voucher?                 @relation(fields: [postedVoucherId], references: [id])
  reversalJournalEntry   JournalEntry?            @relation("ManualJournalReversal", fields: [reversalJournalEntryId], references: [id])
  lines                  ManualJournalEntryLine[]

  @@index([branchId, entryDate])
  @@index([legalEntityCode, entryDate])
  @@index([legalEntityCode, entryType, status])
  @@index([status, entryDate])
}

model ManualJournalEntryLine {
  id                   String             @id @default(uuid())
  manualJournalEntryId String
  lineNo               Int
  glAccountId          String
  debit                Decimal            @default(0) @db.Decimal(18, 2)
  credit               Decimal            @default(0) @db.Decimal(18, 2)
  memo                 String?
  glAccount            GlAccount          @relation(fields: [glAccountId], references: [id])
  manualJournalEntry   ManualJournalEntry @relation(fields: [manualJournalEntryId], references: [id], onDelete: Cascade)

  @@unique([manualJournalEntryId, lineNo])
  @@index([manualJournalEntryId])
}

/// Payment Voucher โ€” outbound disbursement operational document (Phase F1C).
/// Document numbers: PAV-YYnnnn โ€” see docs/99_ASA_HANDBOOK.md and FINANCE_PAY_DOCUMENT_DESIGN.md.
model PaymentVoucher {
  id                   String               @id @default(uuid())
  entryNo              String               @unique
  status               PaymentVoucherStatus @default(DRAFT)
  branchId             String
  legalEntityCode      String
  entryDate            DateTime
  payFromAccountId     String
  payeeName            String
  refNo                String?
  chequeNo             String?
  description          String?
  totalAmount          Decimal              @default(0) @db.Decimal(18, 2)
  createdByStaffId     String
  submittedAt          DateTime?
  submittedByStaffId   String?
  confirmedAt          DateTime?
  confirmedByStaffId   String?
  postedAt             DateTime?
  postedByStaffId      String?
  cancelledAt          DateTime?
  cancelledByStaffId   String?
  cancelReason         String?
